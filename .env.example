# Copy to .env.local for development. In production these live in Vercel environment variables, never in code.

# Site
NEXT_PUBLIC_SITE_URL=https://kalaverio.com

# Launch override for testing only: before | open | closed. Leave unset in production; dates in lib/site.ts decide.
# LAUNCH_STATE=open

# Supabase (its own project, not Zenith's). Service role is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay. Use rzp_test_ keys until Day 12.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Kalaverio <orders@kalaverio.com>"

# Sanity (optional; without it the site uses lib/sets.ts)
SANITY_PROJECT_ID=
SANITY_DATASET=production
